\#!/bin/env bash

# HINT: You can test the result of this script using the following command:
# printf "8000\n2000\n" | ./memory-checker

# Step 1: Read two numbers from stdin.
#   First line = total RAM in MB, second line = used RAM in MB.
read -r total_mb
read -r used_mb

# Step 2: Calculate free MB using bash arithmetic expansion $(( )) with subtraction.
free_mb=$(( total_mb - used_mb ))
# Step 3: Calculate usage percentage using $(( )) with multiplication and division.
usage=$(( used_mb * 100 / total_mb ))
# Step 4: Determine status using if/elif/else with arithmetic conditions (( )).
if (( usage >= 90 )); then
    status="Critical"
elif (( usage >= 70 )); then
    status="Warning"
else
    status="Normal"
fi

# Step 5: Print the three output lines using echo, embedding variables directly.
echo "Free: $free_mb MB"
echo "Usage: $usage%"
echo "Status: $status"



